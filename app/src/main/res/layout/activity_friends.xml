<?xml version="1.0" encoding="utf-8"?>
<!-- 1. Use a FrameLayout as the root to overlay views -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    tools:context=".Friends.FriendsActivity">

    <!-- Your existing MaterialCardView -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <!-- The LinearLayout containing all your content remains the same -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- ... All your existing content (Add Friend, Requests, Friends List) goes here ... -->
            <!-- I'll just show the start and end for brevity -->

            <!-- Section for Adding a Friend -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add a Friend"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/editTextShareId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter friend's Share ID"
                android:inputType="textCapCharacters"
                android:maxLines="1" />

            <Button
                android:id="@+id/buttonAddFriend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Send Request"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"/>

            <!-- Friend Requests Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Friend Requests"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:layout_marginBottom="8dp"/>

            <!-- Friend Requests RecyclerView and TextView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/requestsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="200dp"
                android:visibility="gone"
                tools:listitem="@layout/friend_request_item"
                tools:visibility="visible"
                tools:itemCount="1"/>

            <TextView
                android:id="@+id/tvNoRequests"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No new requests."
                android:textColor="?android:attr/textColorSecondary"/>

            <!-- Another Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <!-- Your Friends Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Friends"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:layout_marginBottom="8dp"/>

            <!-- Friends RecyclerView and TextView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/friendsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="250dp"
                android:visibility="gone"
                tools:listitem="@layout/friend_item"
                tools:visibility="visible"
                tools:itemCount="3"/>

            <TextView
                android:id="@+id/tvNoFriends"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You haven't added any friends yet."
                android:textColor="?android:attr/textColorSecondary"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 2. ADD THIS CLOSE BUTTON -->
    <!-- It sits on top of the card in the top-right corner of the screen -->
    <ImageButton
        android:id="@+id/buttonClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close"
        android:src="@drawable/ic_close"
        app:tint="?attr/colorOnPrimary"
        android:backgroundTint="#FFFFFF"/>

</FrameLayout>

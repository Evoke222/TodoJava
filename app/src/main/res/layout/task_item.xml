<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardElevation="2dp"
    app:cardCornerRadius="12dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorPrimaryContainer">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/taskCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:buttonTint="?attr/colorPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/taskTitleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintEnd_toStartOf="@id/button_delete_task"
            app:layout_constraintStart_toEndOf="@id/taskCheckBox"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="This is a sample task title" />

        <TextView
            android:id="@+id/taskDueDateTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="#EF4444"
            app:layout_constraintStart_toStartOf="@id/taskTitleTextView"
            app:layout_constraintEnd_toEndOf="@id/taskTitleTextView"
            app:layout_constraintTop_toBottomOf="@id/taskTitleTextView"
            tools:text="Due: 2024-12-25" />

        <TextView
            android:id="@+id/taskDetailsTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="@id/taskTitleTextView"
            app:layout_constraintEnd_toEndOf="@id/taskTitleTextView"
            app:layout_constraintTop_toBottomOf="@id/taskDueDateTextView"
            tools:text="Here are some more details about the task." />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipRemindMe"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Remind me"
            android:textSize="12sp"
            android:textColor="?attr/colorPrimary"
            app:chipIconTint="?attr/colorPrimary"
            app:chipBackgroundColor="?attr/colorPrimaryContainer"
            app:chipStrokeWidth="0dp"
            app:chipIcon="@drawable/ic_notifications"
            app:layout_constraintStart_toStartOf="@id/taskTitleTextView"
            app:layout_constraintTop_toBottomOf="@id/taskDetailsTextView" />

        <LinearLayout
            android:id="@+id/layoutMembers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="@id/taskTitleTextView"
            app:layout_constraintTop_toBottomOf="@id/chipRemindMe">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivOwner"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_default_profile"
                android:contentDescription="Owner"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivSharedWith"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="-8dp"
                android:src="@drawable/ic_default_profile"
                android:visibility="gone"
                android:contentDescription="Shared with"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent" />

            <TextView
                android:id="@+id/tvMemberNames"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                tools:text="You + John" />
        </LinearLayout>

        <!-- Strike-through view for the pfp icons and names -->
        <View
            android:id="@+id/memberStrikeThrough"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:background="?attr/colorPrimary"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/layoutMembers"
            app:layout_constraintEnd_toEndOf="@id/layoutMembers"
            app:layout_constraintTop_toTopOf="@id/layoutMembers"
            app:layout_constraintBottom_toBottomOf="@id/layoutMembers" />

        <ImageButton
            android:id="@+id/button_delete_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete task"
            app:tint="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/taskTypeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:textStyle="italic"
            android:padding="6dp"
            android:textColor="?attr/colorOnPrimary"
            android:background="@drawable/bg_type_tag"
            android:backgroundTint="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="Task" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
